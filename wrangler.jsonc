{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "storefront-next",
	"compatibility_date": "2026-07-22",
	"dev": {
		"port": 3040
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		// These ARE the real production values. There is no separate env.production —
		// this top-level (unnamed) config is what's deployed by plain `npm run deploy`
		// (`opennextjs-cloudflare deploy --env ""`), to the worker named "storefront-next"
		// bound to the shops.fypestore.com / *.fypestore.com routes below.
		// CONFIRMED (2026-07-23, real browser test): NEXT_PUBLIC_API_BASE_URL here — and in .dev.vars — does NOT
		// reach the client bundle. Next.js inlines NEXT_PUBLIC_* vars at build time by reading its OWN env loader
		// (.env.local / .env.production.local, standard Next.js convention), which runs before the Cloudflare
		// adapter's .dev.vars injection even happens. Client-side code was silently calling relative URLs against
		// the Worker's own origin instead of the backend until .env.local was added — see that file, not this one,
		// for the value that actually matters to client code.
		"API_BASE_URL": "https://api.fypestore.com/api/v1",
		"NEXT_PUBLIC_API_BASE_URL": "https://api.fypestore.com/api/v1"
	},
	"kv_namespaces": [
		{
			"binding": "FYPE_TENANT_CACHE",
			"id": "55ab9eaeeee0478494db64b87b26389e"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "storefront-next"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Wires shops.fypestore.com (Cloudflare for SaaS fallback origin, production)
	// to this Worker. Requires a proxied DNS record for shops.fypestore.com in the zone.
	//
	// *.fypestore.com/* is the per-store production wildcard, mirroring staging's
	// *.test.fypestore.com/* — every store's own subdomain (e.g. somestore.fypestore.com)
	// resolves here automatically, no per-store route needed.
	//
	// */* catches merchant custom hostnames (Cloudflare for SaaS, e.g. www.shop.com):
	// their Host isn't under fypestore.com, so no pattern above matches them and
	// Cloudflare would go to the fallback origin's own server instead (522). See
	// https://developers.cloudflare.com/cloudflare-for-platforms/cloudflare-for-saas/start/advanced-settings/worker-as-origin/
	// The most specific route wins, so staging's *.test.fypestore.com/* and the
	// zone's exclusion routes (Worker: None, e.g. api.fypestore.com/*) still apply.
	// Production only — staging declares its own routes and must never get */*.
	"routes": [
		{
			"pattern": "shops.fypestore.com/*",
			"zone_name": "fypestore.com"
		},
		{
			"pattern": "*.fypestore.com/*",
			"zone_name": "fypestore.com"
		},
		{
			"pattern": "*/*",
			"zone_name": "fypestore.com"
		}
	],
	"env": {
		"staging": {
			// Deploys as "storefront-next-staging" (top-level name + "-staging", Wrangler default).
			// Bindings/vars are NOT inherited from top-level config in wrangler.jsonc and must be
			// fully redeclared here — see https://developers.cloudflare.com/workers/wrangler/environments/
			"vars": {
				"API_BASE_URL": "https://test-api.fypestore.com/api/v1",
				"NEXT_PUBLIC_API_BASE_URL": "https://test-api.fypestore.com/api/v1"
			},
			// Wires test-shops.fypestore.com (staging fallback-origin hostname; kept
			// one label deep so it's covered by the free Universal SSL wildcard cert,
			// unlike shops.test.fypestore.com which would need Advanced Certificate
			// Manager) to this Worker. No Cloudflare for SaaS/Custom Hostnames setup
			// for staging — this is plumbing parity only, per product decision.
			//
			// *.test.fypestore.com/* is the per-store staging wildcard, mirroring
			// production's *.fypestore.com/* — every staging test store's own
			// subdomain (e.g. ironman.test.fypestore.com) resolves here automatically,
			// no per-store route needed. Requires Advanced Certificate Manager (ACM)
			// activated on the zone with a cert covering *.test.fypestore.com, since
			// the free Universal SSL cert only covers one label deep.
			"routes": [
				{
					"pattern": "test-shops.fypestore.com/*",
					"zone_name": "fypestore.com"
				},
				{
					"pattern": "*.test.fypestore.com/*",
					"zone_name": "fypestore.com"
				}
			],
			// Staging's own tenant cache, so staging never reads or writes production's
			// tenant:<domain> entries. Create it with:
			//   npx wrangler kv namespace create FYPE_TENANT_CACHE_STAGING
			// and replace the placeholder below with the id it prints. Staging deploys
			// fail until this is done.
			"kv_namespaces": [
				{
					"binding": "FYPE_TENANT_CACHE",
					"id": "REPLACE_WITH_STAGING_KV_NAMESPACE_ID"
				}
			],
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "storefront-next-staging"
				}
			],
			"images": {
				"binding": "IMAGES"
			}
		}
	}
}